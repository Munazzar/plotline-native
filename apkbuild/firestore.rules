rules_version = '2';
// Plotline sharing. Only shared items live here, end-to-end encrypted; everyone's plan stays in their own Google Drive.
// circles/{cid}          one shared item: owner, members (emails), opub (owner's public key),
//                        locks (the item key locked for each member), enc (the encrypted item)
// circles/{cid}/ms/{em}  one person's encrypted progress for it; only that person can write it
// keys/{em}              a person's PUBLIC key (the private half never leaves their own Drive)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function circle(cid) { return get(/databases/$(database)/documents/circles/$(cid)).data; }
    function okCircle(d) {
      return d.keys().hasOnly(['owner', 'members', 'opub', 'locks', 'enc', 'created', 'u'])
        && d.owner == me() && d.members is list && me() in d.members && d.members.size() <= 21
        && d.opub is string && d.opub.size() <= 200
        && d.locks is string && d.locks.size() <= 20000
        && d.enc is string && d.enc.size() <= 60000;
    }

    match /circles/{cid} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && okCircle(request.resource.data);
      allow update: if signedIn() && resource.data.owner == me() && okCircle(request.resource.data);
      allow delete: if signedIn() && resource.data.owner == me();

      match /ms/{em} {
        allow read: if signedIn() && me() in circle(cid).members;
        allow create, update: if signedIn() && em == me() && me() in circle(cid).members
          && request.resource.data.keys().hasOnly(['status', 'enc', 'u'])
          && request.resource.data.status in ['joined', 'declined', 'left']
          && request.resource.data.enc is string && request.resource.data.enc.size() <= 40000;
        allow delete: if signedIn() && (em == me() || circle(cid).owner == me());
      }
    }

    match /keys/{em} {
      allow read: if signedIn();
      allow create, update: if signedIn() && em == me()
        && request.resource.data.keys().hasOnly(['pub', 'fp', 'u'])
        && request.resource.data.pub is string && request.resource.data.pub.size() <= 200
        && request.resource.data.fp is string && request.resource.data.fp.size() <= 64;
      allow delete: if signedIn() && em == me();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
